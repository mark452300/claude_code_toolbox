{
    "mcpServers": {
        "toolbox-mysql": {
            "command": "npx",
            "args": [
                "-y",
                "@toolbox-sdk/server",
                "--prebuilt=mysql"
            ],
            "env": {
                "MYSQL_HOST": "${user_config.mysql_host}",
                "MYSQL_PORT": "${user_config.mysql_port}",
                "MYSQL_USER": "${user_config.mysql_user}",
                "MYSQL_PASSWORD": "${user_config.mysql_password}",
                "MYSQL_DATABASE": "${user_config.mysql_database}"
            }
        },
        "context7": {
            "command": "npx",
            "args": [
                "-y",
                "@upstash/context7-mcp",
                "--api-key",
                "${user_config.context7_api_key}"
            ]
        },
        "playwright": {
            "command": "npx",
            "args": [
                "@playwright/mcp@latest"
            ]
        },
        "serena": {
            "command": "serena",
            "args": [
                "start-mcp-server",
                "--context",
                "claude-code",
                "--project",
                "${CLAUDE_PROJECT_DIR}"
            ]
        },
        "codegraph": {
            "type": "stdio",
            "command": "codegraph",
            "args": [
                "serve",
                "--mcp"
            ]
        },
        "prompts.chat": {
            "command": "npx",
            "args": [
                "-y",
                "prompts.chat",
                "mcp"
            ]
        }
    }
}
